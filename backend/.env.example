# ==============================================================================
# FarmHawk Backend Environment Configuration Template
# Copy this file to .env and configure your local credentials
# ==============================================================================
PORT=5001
HOST=0.0.0.0
SECRET_KEY=your-secret-key-here
DEMO_FARMER_PHONE=+919876543210

# TextBee SIM Gateway Configuration (Android Device Relay)
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here

# Alternative SMS & WhatsApp Gateways
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
